//@version=6
// ══════════════════════════════════════════════════════════════════════════════════════════════════
// Combined 7 Indicators in One Script (each works independently)
// ──────────────────────────────────────────────────────────────────────────────────────────────────
//  1) RSI Support & Resistance by DGT             (© dgtrd)
//  2) LuxAlgo - Smart Money Concepts + Liquidity Voids  (© LuxAlgo)  [upgraded v5 → v6]
//  3) Trendlines with Breaks [LuxAlgo]            (© LuxAlgo)        [upgraded v5 → v6]
//  4) Support and Resistance Levels with Breaks   (© LuxAlgo / profitgang)
//  5) Wyckoff Event Detection [Alpha Extract]     (© AlphaExtract)
//  6) Wyckoff Accumulation Distribution           (© faytterro)      [upgraded v5 → v6]
//      + Wyckoff Phases (A, B, C, D, E) with Arabic descriptions
//  7) Fast / Slow RSI Crossover                   (custom – BUY/SELL on cross)
// ══════════════════════════════════════════════════════════════════════════════════════════════════

indicator('All-in-One: SMC + Wyckoff + RSI Tools',
     'AIO ☼☾',
     overlay            = true,
     max_boxes_count    = 500,
     max_labels_count   = 500,
     max_lines_count    = 500,
     max_bars_back      = 1000)

// ══════════════════════════════════════════════════════════════════════════════════════════════════
// MASTER ENABLE / DISABLE
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G_MASTER = '⚙️ Master Toggle (Enable / Disable each indicator)'
en_rsisr = input.bool(true , '1) RSI Support & Resistance (DGT)'        , group = G_MASTER)
en_smc   = input.bool(true , '2) LuxAlgo SMC + Liquidity Voids'         , group = G_MASTER)
en_tl    = input.bool(true , '3) Trendlines with Breaks (LuxAlgo)'      , group = G_MASTER)
en_srb   = input.bool(true , '4) S/R Levels with Breaks (LuxAlgo)'      , group = G_MASTER)
en_we    = input.bool(true , '5) Wyckoff Event Detection (AlphaExtract)', group = G_MASTER)
en_wad   = input.bool(true , '6) Wyckoff Accum/Dist + Phases (faytterro)', group = G_MASTER)
en_fsr   = input.bool(true , '7) Fast/Slow RSI Crossover'               , group = G_MASTER)


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (1) RSI SUPPORT & RESISTANCE — © dgtrd
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G1 = '①  RSI S&R'

rsisr_display = display.all - display.status_line

rsisr_source     = input.string('Price (close)', 'Source', options = ['Price (close)', 'On Balance Volume (OBV)'], group = G1, display = rsisr_display)
rsisr_length     = input.int(14, 'Length', minval = 1, group = G1, display = rsisr_display)
rsisr_obThresh   = input.int(70, 'Overbought', minval = 50, maxval = 100, group = G1, display = rsisr_display)
rsisr_bullZone   = input.int(60, 'Bull Zone',  minval = 50, maxval = 65,  group = G1, display = rsisr_display)
rsisr_bearZone   = input.int(40, 'Bear Zone',  minval = 35, maxval = 50,  group = G1, display = rsisr_display)
rsisr_osThresh   = input.int(30, 'Oversold',   minval = 1,  maxval = 50,  group = G1, display = rsisr_display)

rsisr_bullColor  = input.color(color.teal, 'Bullish', inline='c1', group = G1)
rsisr_midColor   = input.color(color.gray, 'Neutral', inline='c1', group = G1)
rsisr_bearColor  = input.color(color.red , 'Bearish', inline='c1', group = G1)

rsisr_showSR     = input.bool(true , 'Show RSI S&R Zones', group = G1, display = rsisr_display)
rsisr_fill       = input.bool(true , 'Zone Fills'        , group = G1)
rsisr_obos       = input.bool(false, 'OB/OS Bar Marks'   , group = G1)
rsisr_showRRSI   = input.bool(true , 'Reverse RSI Price Levels', group = G1, display = rsisr_display)
rsisr_shRRSI     = input.bool(false, 'Reverse RSI Price Bands' , group = G1, display = rsisr_display)
rsisr_oscOn      = input.bool(true , 'Enable RSI Overlay', group = G1)
rsisr_oscPlace   = input.string('Top', 'Overlay Placement', options=['Top','Bottom'], group = G1, display = rsisr_display)
rsisr_oscHight   = 11 - input.int(7, 'Overlay Height', minval = 3, maxval = 10, group = G1, display = rsisr_display)
rsisr_lookback   = input.int(200, 'Overlay Length', minval = 10, maxval = 495, group = G1, display = rsisr_display)

// ── functions
rsisr_f_getPrice(_osc, _thresh, _cross) =>
    avgHigh = math.avg(high, close)
    avgLow  = math.avg(low , close)
    var return_1 = 0.
    if (_cross == 'over' or _cross == 'both') and ta.crossover(_osc, _thresh)
        return_1 := avgHigh
    if (_cross == 'under' or _cross == 'both') and ta.crossunder(_osc, _thresh)
        return_1 := avgLow
    return_1

rsisr_f_rsiComp(_src, _len) =>
    _change  = ta.change(_src)
    _avgGain = ta.rma(math.max(_change, 0.), _len)
    _avgLoss = ta.rma(math.abs(math.min(_change, 0.)), _len)
    [_avgGain, _avgLoss]

rsisr_f_revRSI(_src, _len, _target, _avgGain, _avgLoss) =>
    _rs = _target / math.max(100 - _target, 0.001)
    float _price = na
    if _target >= 50
        _gainNew = _rs * _avgLoss * _len - _avgGain * (_len - 1)
        _price := _gainNew > 0 ? _src + _gainNew : _src
    else
        _lossNew = _avgGain / math.max(_rs, 0.0001) * _len - _avgLoss * (_len - 1)
        _price := _lossNew > 0 ? _src - _lossNew : _src
    _price

// ── calculations
rsisr_src     = rsisr_source == 'Price (close)' ? close : ta.obv
rsisr_osc     = ta.rsi(rsisr_src, rsisr_length)

rsisr_co_ob   = rsisr_f_getPrice(rsisr_osc, rsisr_obThresh , 'over')
rsisr_cu_ob   = rsisr_f_getPrice(rsisr_osc, rsisr_obThresh , 'under')
rsisr_bull    = rsisr_f_getPrice(rsisr_osc, rsisr_bullZone , 'both')
rsisr_bear    = rsisr_f_getPrice(rsisr_osc, rsisr_bearZone , 'both')
rsisr_co_os   = rsisr_f_getPrice(rsisr_osc, rsisr_osThresh , 'over')
rsisr_cu_os   = rsisr_f_getPrice(rsisr_osc, rsisr_osThresh , 'under')

[rsisr_avgGain, rsisr_avgLoss] = rsisr_f_rsiComp(rsisr_src, rsisr_length)
rsisr_priceOB   = rsisr_f_revRSI(rsisr_src, rsisr_length, rsisr_obThresh, rsisr_avgGain, rsisr_avgLoss)
rsisr_priceBull = rsisr_f_revRSI(rsisr_src, rsisr_length, rsisr_bullZone, rsisr_avgGain, rsisr_avgLoss)
rsisr_priceMid  = rsisr_f_revRSI(rsisr_src, rsisr_length, 50            , rsisr_avgGain, rsisr_avgLoss)
rsisr_priceBear = rsisr_f_revRSI(rsisr_src, rsisr_length, rsisr_bearZone, rsisr_avgGain, rsisr_avgLoss)
rsisr_priceOS   = rsisr_f_revRSI(rsisr_src, rsisr_length, rsisr_osThresh, rsisr_avgGain, rsisr_avgLoss)

// ── plots
p_co_ob = plot(en_rsisr and rsisr_showSR and rsisr_co_ob > 0 ? rsisr_co_ob : na, 'RSI OB Cross',     rsisr_co_ob == rsisr_co_ob[1] ? rsisr_bullColor : na, 2, display = rsisr_display)
p_cu_ob = plot(en_rsisr and rsisr_showSR and rsisr_cu_ob > 0 ? rsisr_cu_ob : na, 'RSI OB Exit',      rsisr_cu_ob == rsisr_cu_ob[1] ? rsisr_bullColor : na, 1, plot.style_cross, display = rsisr_display)
p_bull  = plot(en_rsisr and rsisr_showSR and rsisr_bull  > 0 ? rsisr_bull  : na, 'RSI Bull Thresh',  rsisr_bull  == rsisr_bull[1]  ? rsisr_bullColor : na, 1, display = rsisr_display)
fill(p_co_ob, p_bull, en_rsisr and rsisr_fill ? color.new(rsisr_bullColor, 90) : na, title = 'RSI Bull Zone')

p_bear  = plot(en_rsisr and rsisr_showSR and rsisr_bear  > 0 ? rsisr_bear  : na, 'RSI Bear Thresh',  rsisr_bear  == rsisr_bear[1]  ? rsisr_bearColor : na, 1, display = rsisr_display)
p_co_os = plot(en_rsisr and rsisr_showSR and rsisr_co_os > 0 ? rsisr_co_os : na, 'RSI OS Rebound',   rsisr_co_os == rsisr_co_os[1] ? rsisr_bearColor : na, 1, plot.style_cross, display = rsisr_display)
p_cu_os = plot(en_rsisr and rsisr_showSR and rsisr_cu_os > 0 ? rsisr_cu_os : na, 'RSI OS Breakdown', rsisr_cu_os == rsisr_cu_os[1] ? rsisr_bearColor : na, 2, display = rsisr_display)
fill(p_cu_os, p_bear, en_rsisr and rsisr_fill ? color.new(rsisr_bearColor, 90) : na, title = 'RSI Bear Zone')

plotshape(en_rsisr and rsisr_obos and rsisr_osc > rsisr_obThresh, 'RSI OB bar', shape.triangledown, location.abovebar, color.new(rsisr_bearColor, 25), size = size.tiny)
plotshape(en_rsisr and rsisr_obos and rsisr_osc < rsisr_osThresh, 'RSI OS bar', shape.triangleup,   location.belowbar, color.new(rsisr_bullColor, 25), size = size.tiny)

alertcondition(ta.crossover (close, rsisr_co_ob), 'Price Crossed Above OB Level', 'RSI S&R: Price crossed above prior RSI OB level')
alertcondition(ta.crossunder(close, rsisr_cu_os), 'Price Crossed Below OS Level', 'RSI S&R: Price crossed below prior RSI OS level')

// ── RSI overlay oscillator on chart
var rsisr_a_lines = array.new_line()
var rsisr_a_fill  = array.new_linefill()

rsisr_priceHi = ta.highest(high, rsisr_lookback)
rsisr_priceLo = ta.lowest (low , rsisr_lookback)

if barstate.islast and en_rsisr and rsisr_oscOn
    while array.size(rsisr_a_lines) > 0
        line.delete(array.shift(rsisr_a_lines))
    while array.size(rsisr_a_fill) > 0
        linefill.delete(array.shift(rsisr_a_fill))

    pcr  = (rsisr_priceHi - rsisr_priceLo) / rsisr_priceHi / rsisr_oscHight / 100
    base = rsisr_oscPlace == 'Top' ? rsisr_priceHi : rsisr_priceLo
    obLvl   = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_obThresh : -1 * (100 - rsisr_obThresh)) * pcr)
    bullLvl = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_bullZone : -1 * (100 - rsisr_bullZone)) * pcr)
    midLvl  = base * (1 + (rsisr_oscPlace == 'Top' ? 50             : -1 * (100 - 50))             * pcr)
    bearLvl = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_bearZone : -1 * (100 - rsisr_bearZone)) * pcr)
    osLvl   = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_osThresh : -1 * (100 - rsisr_osThresh)) * pcr)

    array.push(rsisr_a_lines, line.new(bar_index[rsisr_lookback], obLvl  , bar_index, obLvl  , xloc.bar_index, extend.none, rsisr_bullColor, line.style_dotted, 2))
    array.push(rsisr_a_lines, line.new(bar_index[rsisr_lookback], bullLvl, bar_index, bullLvl, xloc.bar_index, extend.none, rsisr_bullColor, line.style_dotted, 1))
    array.push(rsisr_a_fill , linefill.new(array.get(rsisr_a_lines, 0), array.get(rsisr_a_lines, 1), color.new(rsisr_bullColor, 90)))
    array.push(rsisr_a_lines, line.new(bar_index[rsisr_lookback], bearLvl, bar_index, bearLvl, xloc.bar_index, extend.none, rsisr_bearColor, line.style_dotted, 1))
    array.push(rsisr_a_lines, line.new(bar_index[rsisr_lookback], osLvl  , bar_index, osLvl  , xloc.bar_index, extend.none, rsisr_bearColor, line.style_dotted, 2))
    array.push(rsisr_a_fill , linefill.new(array.get(rsisr_a_lines, 2), array.get(rsisr_a_lines, 3), color.new(rsisr_bearColor, 90)))
    array.push(rsisr_a_lines, line.new(bar_index[rsisr_lookback], midLvl , bar_index, midLvl , xloc.bar_index, extend.none, rsisr_midColor , line.style_dotted, 1))

    for bi = 0 to rsisr_lookback - 1
        v1 = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_osc[bi]     : -1 * (100 - rsisr_osc[bi]))     * pcr)
        v2 = base * (1 + (rsisr_oscPlace == 'Top' ? rsisr_osc[bi + 1] : -1 * (100 - rsisr_osc[bi + 1])) * pcr)
        array.push(rsisr_a_lines, line.new(bar_index[bi], v1, bar_index[bi + 1], v2, xloc.bar_index, extend.none, #7e57c2, line.style_solid, 2))


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (2) LuxAlgo — SMART MONEY CONCEPTS + LIQUIDITY VOIDS  [v5 → v6]
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G2_SMART = '②  SMC – General'
G2_INT   = '②  SMC – Internal Structure'
G2_SW    = '②  SMC – Swing Structure'
G2_OB    = '②  SMC – Order Blocks'
G2_EQ    = '②  SMC – EQH / EQL'
G2_FVG   = '②  SMC – Fair Value Gaps'
G2_LV    = '②  SMC – Liquidity Voids'
G2_LVL   = '②  SMC – MTF Levels'
G2_PD    = '②  SMC – Premium / Discount'

smc_BULLISH_LEG = 1
smc_BEARISH_LEG = 0
smc_BULLISH = +1
smc_BEARISH = -1
smc_GREEN = #089981
smc_RED   = #F23645
smc_BLUE  = #2157f3
smc_GRAY  = #878b94
smc_MONO_BULL = #b2b5be
smc_MONO_BEAR = #5d606b
smc_HIST = 'Historical'
smc_PRES = 'Present'
smc_COL  = 'Colored'
smc_MONO = 'Monochrome'
smc_ALL  = 'All'
smc_BOS  = 'BOS'
smc_CHOCH= 'CHoCH'
smc_ATR  = 'Atr'
smc_RNG  = 'Cumulative Mean Range'
smc_CLOSE= 'Close'
smc_HL   = 'High/Low'
smc_SOL  = '⎯⎯⎯'
smc_DSH  = '----'
smc_DOT  = '····'

smc_modeInput   = input.string(smc_HIST, 'Mode',  group = G2_SMART, options=[smc_HIST, smc_PRES])
smc_styleInput  = input.string(smc_COL , 'Style', group = G2_SMART, options=[smc_COL , smc_MONO])
smc_showTrend   = input.bool  (false   , 'Color Candles', group = G2_SMART)

smc_showInternals = input.bool(true, 'Show Internal Structure', group = G2_INT)
smc_showIntBull   = input.string(smc_ALL, 'Bullish Structure', group = G2_INT, inline='ibull', options=[smc_ALL, smc_BOS, smc_CHOCH])
smc_intBullClr    = input.color(smc_GREEN, '', group = G2_INT, inline='ibull')
smc_showIntBear   = input.string(smc_ALL, 'Bearish Structure', group = G2_INT, inline='ibear', options=[smc_ALL, smc_BOS, smc_CHOCH])
smc_intBearClr    = input.color(smc_RED  , '', group = G2_INT, inline='ibear')
smc_intConfFilter = input.bool(false, 'Confluence Filter', group = G2_INT)
smc_intLblSize    = input.string('tiny', 'Internal Label Size', group = G2_INT, options=['tiny','small','normal'])

smc_showStructure  = input.bool(true, 'Show Swing Structure', group = G2_SW)
smc_showSwBull     = input.string(smc_ALL, 'Bullish Structure', group = G2_SW, inline='sbull', options=[smc_ALL, smc_BOS, smc_CHOCH])
smc_swBullClr      = input.color(smc_GREEN, '', group = G2_SW, inline='sbull')
smc_showSwBear     = input.string(smc_ALL, 'Bearish Structure', group = G2_SW, inline='sbear', options=[smc_ALL, smc_BOS, smc_CHOCH])
smc_swBearClr      = input.color(smc_RED  , '', group = G2_SW, inline='sbear')
smc_swLblSize      = input.string('small', 'Swing Label Size', group = G2_SW, options=['tiny','small','normal'])
smc_showSwings     = input.bool(false, 'Show Swing Points', group = G2_SW, inline='sw')
smc_swLength       = input.int (50   , '', group = G2_SW, minval = 10, inline='sw')
smc_showHLSwings   = input.bool(true , 'Show Strong/Weak High/Low', group = G2_SW)

smc_showIntOB    = input.bool(true , 'Internal Order Blocks', group = G2_OB, inline='iob')
smc_intOBSize    = input.int (5    , '', group = G2_OB, minval = 1, maxval = 20, inline='iob')
smc_showSwOB     = input.bool(false, 'Swing Order Blocks'   , group = G2_OB, inline='ob')
smc_swOBSize     = input.int (5    , '', group = G2_OB, minval = 1, maxval = 20, inline='ob')
smc_obFilter     = input.string(smc_ATR, 'OB Filter',     group = G2_OB, options=[smc_ATR, smc_RNG])
smc_obMitigation = input.string(smc_HL , 'OB Mitigation', group = G2_OB, options=[smc_CLOSE, smc_HL])
smc_intBullOBClr = input.color(color.new(#3179f5, 80), 'Internal Bullish OB', group = G2_OB)
smc_intBearOBClr = input.color(color.new(#f77c80, 80), 'Internal Bearish OB', group = G2_OB)
smc_swBullOBClr  = input.color(color.new(#1848cc, 80), 'Swing Bullish OB'   , group = G2_OB)
smc_swBearOBClr  = input.color(color.new(#b22833, 80), 'Swing Bearish OB'   , group = G2_OB)

smc_showEQ       = input.bool (true, 'Show EQH / EQL', group = G2_EQ)
smc_eqLength     = input.int  (3   , 'Bars Confirmation', group = G2_EQ, minval = 1)
smc_eqThreshold  = input.float(0.1 , 'Threshold', group = G2_EQ, minval = 0, maxval = 0.5, step = 0.1)
smc_eqLblSize    = input.string('tiny', 'EQ Label Size', group = G2_EQ, options=['tiny','small','normal'])

smc_showFVG      = input.bool (true, 'Show Fair Value Gaps', group = G2_FVG)
smc_fvgAutoTh    = input.bool (true, 'Auto Threshold'      , group = G2_FVG)
smc_fvgTF        = input.timeframe('', 'Timeframe'         , group = G2_FVG)
smc_fvgBullClr   = input.color(color.new(#00ff68, 70), 'Bullish FVG', group = G2_FVG)
smc_fvgBearClr   = input.color(color.new(#ff0008, 70), 'Bearish FVG', group = G2_FVG)
smc_fvgExtend    = input.int  (1, 'Extend FVG', group = G2_FVG, minval = 0)

smc_lqMode = input.string('Historical', 'LV Mode', options=['Present','Historical'], inline='MOD', group = G2_LV)
smc_lqBack = input.int(360, 'LV # Bars', minval=100, maxval=5000, step=10, inline='MOD', group = G2_LV)
smc_lqTH   = input.float(.5, 'LV Threshold', minval=0, step=.1, group = G2_LV)
smc_lqBC   = input.color(color.new(#089981, 73), 'LV Bullish', inline='VD', group = G2_LV)
smc_lqSC   = input.color(color.new(#f23645, 73), 'LV Bearish', inline='VD', group = G2_LV)
smc_lqTX   = input.bool (true, 'LV Label', inline='VD', group = G2_LV)
smc_lqVF   = input.bool (true, 'Filled LV', inline='FL', group = G2_LV)
smc_lqFC   = input.color(color.new(#787b86, 73), '', inline='FL', group = G2_LV)

smc_showDaily   = input.bool(false, 'Daily', inline='daily', group = G2_LVL)
smc_dStyle      = input.string(smc_SOL, '', inline='daily', group = G2_LVL, options=[smc_SOL, smc_DSH, smc_DOT])
smc_dColor      = input.color(smc_BLUE,'', inline='daily', group = G2_LVL)
smc_showWeekly  = input.bool(false, 'Weekly', inline='weekly', group = G2_LVL)
smc_wStyle      = input.string(smc_SOL, '', inline='weekly', group = G2_LVL, options=[smc_SOL, smc_DSH, smc_DOT])
smc_wColor      = input.color(smc_BLUE,'', inline='weekly', group = G2_LVL)
smc_showMonthly = input.bool(false, 'Monthly', inline='monthly', group = G2_LVL)
smc_mStyle      = input.string(smc_SOL, '', inline='monthly', group = G2_LVL, options=[smc_SOL, smc_DSH, smc_DOT])
smc_mColor      = input.color(smc_BLUE,'', inline='monthly', group = G2_LVL)

smc_showPD      = input.bool (false, 'Premium/Discount Zones', group = G2_PD)
smc_premClr     = input.color(smc_RED  , 'Premium'    , group = G2_PD)
smc_eqClr       = input.color(smc_GRAY , 'Equilibrium', group = G2_PD)
smc_discClr     = input.color(smc_GREEN, 'Discount'   , group = G2_PD)

// ── helper to convert text size
smc_sz(s) =>
    s == 'tiny' ? size.tiny : s == 'normal' ? size.normal : size.small

// ── UDTs
type smc_alerts
    bool intBullBOS   = false
    bool intBearBOS   = false
    bool intBullCHoCH = false
    bool intBearCHoCH = false
    bool swBullBOS    = false
    bool swBearBOS    = false
    bool swBullCHoCH  = false
    bool swBearCHoCH  = false
    bool intBullOB    = false
    bool intBearOB    = false
    bool swBullOB     = false
    bool swBearOB     = false
    bool eqHigh       = false
    bool eqLow        = false
    bool bullFVG      = false
    bool bearFVG      = false

type smc_trailingExtremes
    float top
    float bottom
    int   barTime
    int   barIndex
    int   lastTopTime
    int   lastBottomTime

type smc_fvg
    float top
    float bottom
    int   bias
    box   topBox
    box   bottomBox

type smc_trend
    int bias

type smc_eqDisp
    line  l_ine  = na
    label l_abel = na

type smc_pivot
    float currentLevel
    float lastLevel
    bool  crossed
    int   barTime  = time
    int   barIndex = bar_index

type smc_orderBlock
    float barHigh
    float barLow
    int   barTime
    int   bias

type smc_bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// ── state
var smc_pivot swingHigh    = smc_pivot.new(na,na,false)
var smc_pivot swingLow     = smc_pivot.new(na,na,false)
var smc_pivot internalHigh = smc_pivot.new(na,na,false)
var smc_pivot internalLow  = smc_pivot.new(na,na,false)
var smc_pivot equalHigh    = smc_pivot.new(na,na,false)
var smc_pivot equalLow     = smc_pivot.new(na,na,false)
var smc_trend swingTrend    = smc_trend.new(0)
var smc_trend internalTrend = smc_trend.new(0)
var smc_eqDisp eqHighDisp   = smc_eqDisp.new()
var smc_eqDisp eqLowDisp    = smc_eqDisp.new()
var array<smc_fvg>         fvgs            = array.new<smc_fvg>()
var array<float>           parsedHighs     = array.new<float>()
var array<float>           parsedLows      = array.new<float>()
var array<float>           highsArr        = array.new<float>()
var array<float>           lowsArr         = array.new<float>()
var array<int>             timesArr        = array.new<int>()
var smc_trailingExtremes   trailing        = smc_trailingExtremes.new()
var array<smc_orderBlock>  swOB            = array.new<smc_orderBlock>()
var array<smc_orderBlock>  intOB           = array.new<smc_orderBlock>()
var array<box>             swOBBoxes       = array.new<box>()
var array<box>             intOBBoxes      = array.new<box>()

smc_bar b = smc_bar.new()
var array<box> lqV = array.new_box()

var color smc_swBullColor = smc_styleInput == smc_MONO ? smc_MONO_BULL : smc_swBullClr
var color smc_swBearColor = smc_styleInput == smc_MONO ? smc_MONO_BEAR : smc_swBearClr
var color smc_fvgBullColor = smc_styleInput == smc_MONO ? color.new(smc_MONO_BULL,70) : smc_fvgBullClr
var color smc_fvgBearColor = smc_styleInput == smc_MONO ? color.new(smc_MONO_BEAR,70) : smc_fvgBearClr
var color smc_premColor    = smc_styleInput == smc_MONO ? smc_MONO_BEAR : smc_premClr
var color smc_discColor    = smc_styleInput == smc_MONO ? smc_MONO_BULL : smc_discClr

varip int smc_curBI  = bar_index
varip int smc_lastBI = bar_index
smc_alerts smc_a = smc_alerts.new()
var int smc_initTime = time

smc_bearMitSrc  = smc_obMitigation == smc_CLOSE ? close : high
smc_bullMitSrc  = smc_obMitigation == smc_CLOSE ? close : low
smc_atr         = ta.atr(200)
smc_volMeasure  = smc_obFilter == smc_ATR ? smc_atr : ta.cum(ta.tr) / bar_index
smc_highVolBar  = (high - low) >= (2 * smc_volMeasure)
smc_pHigh       = smc_highVolBar ? low : high
smc_pLow        = smc_highVolBar ? high : low

if en_smc
    parsedHighs.push(smc_pHigh)
    parsedLows .push(smc_pLow)
    highsArr   .push(high)
    lowsArr    .push(low)
    timesArr   .push(time)

// ── functions
smc_leg(int sz) =>
    var leg = 0
    newLegHigh = high[sz] > ta.highest(sz)
    newLegLow  = low [sz] < ta.lowest (sz)
    if newLegHigh
        leg := smc_BEARISH_LEG
    else if newLegLow
        leg := smc_BULLISH_LEG
    leg

smc_startNewLeg(int leg)  => ta.change(leg) != 0
smc_startBearLeg(int leg) => ta.change(leg) == -1
smc_startBullLeg(int leg) => ta.change(leg) == +1

smc_drawLabel(int t_, float p_, string tag, color clr, string st_) =>
    var label l_ = na
    if smc_modeInput == smc_PRES
        l_.delete()
    l_ := label.new(chart.point.new(t_, na, p_), tag, xloc.bar_time, color = color(na), textcolor = clr, style = st_, size = size.small)

smc_drawEqual(smc_pivot p_, float lvl, int sz, bool isHigh) =>
    smc_eqDisp ed = isHigh ? eqHighDisp : eqLowDisp
    string  tag = isHigh ? 'EQH' : 'EQL'
    color   clr = isHigh ? smc_swBearColor : smc_swBullColor
    string  st_ = isHigh ? label.style_label_down : label.style_label_up
    if smc_modeInput == smc_PRES
        line.delete (ed.l_ine)
        label.delete(ed.l_abel)
    ed.l_ine  := line.new(chart.point.new(p_.barTime, na, p_.currentLevel), chart.point.new(time[sz], na, lvl), xloc=xloc.bar_time, color=clr, style=line.style_dotted)
    pos = math.round(0.5 * (p_.barIndex + bar_index - sz))
    ed.l_abel := label.new(chart.point.new(na, pos, lvl), tag, xloc.bar_index, color=color(na), textcolor=clr, style=st_, size=smc_sz(smc_eqLblSize))

smc_getStruct(int sz, bool eq=false, bool internal=false) =>
    leg     = smc_leg(sz)
    newPv   = smc_startNewLeg(leg)
    pvLow   = smc_startBullLeg(leg)
    if newPv
        if pvLow
            smc_pivot p_ = eq ? equalLow : internal ? internalLow : swingLow
            if eq and math.abs(p_.currentLevel - low[sz]) < smc_eqThreshold * smc_atr
                smc_drawEqual(p_, low[sz], sz, false)
            p_.lastLevel    := p_.currentLevel
            p_.currentLevel := low[sz]
            p_.crossed      := false
            p_.barTime      := time[sz]
            p_.barIndex     := bar_index[sz]
            if not eq and not internal
                trailing.bottom        := p_.currentLevel
                trailing.barTime       := p_.barTime
                trailing.barIndex      := p_.barIndex
                trailing.lastBottomTime:= p_.barTime
            if smc_showSwings and not internal and not eq
                smc_drawLabel(time[sz], p_.currentLevel, p_.currentLevel < p_.lastLevel ? 'LL' : 'HL', smc_swBullColor, label.style_label_up)
        else
            smc_pivot p_ = eq ? equalHigh : internal ? internalHigh : swingHigh
            if eq and math.abs(p_.currentLevel - high[sz]) < smc_eqThreshold * smc_atr
                smc_drawEqual(p_, high[sz], sz, true)
            p_.lastLevel    := p_.currentLevel
            p_.currentLevel := high[sz]
            p_.crossed      := false
            p_.barTime      := time[sz]
            p_.barIndex     := bar_index[sz]
            if not eq and not internal
                trailing.top        := p_.currentLevel
                trailing.barTime    := p_.barTime
                trailing.barIndex   := p_.barIndex
                trailing.lastTopTime:= p_.barTime
            if smc_showSwings and not internal and not eq
                smc_drawLabel(time[sz], p_.currentLevel, p_.currentLevel > p_.lastLevel ? 'HH' : 'LH', smc_swBearColor, label.style_label_down)

smc_drawStruct(smc_pivot p_, string tag, color clr, string lst, string lblSt, string lblSz) =>
    var line  l_ = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label lb = label.new(na,na)
    if smc_modeInput == smc_PRES
        l_.delete()
        lb.delete()
    l_ := line.new(chart.point.new(p_.barTime, na, p_.currentLevel), chart.point.new(time, na, p_.currentLevel), xloc.bar_time, color=clr, style=lst)
    lb := label.new(chart.point.new(na, math.round(0.5*(p_.barIndex+bar_index)), p_.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=clr, style=lblSt, size=smc_sz(lblSz))

smc_deleteOB(bool internal=false) =>
    array<smc_orderBlock> obs = internal ? intOB : swOB
    for [idx, ob] in obs
        bool crossed = false
        if smc_bearMitSrc > ob.barHigh and ob.bias == smc_BEARISH
            crossed := true
            if internal
                smc_a.intBearOB := true
            else
                smc_a.swBearOB  := true
        else if smc_bullMitSrc < ob.barLow and ob.bias == smc_BULLISH
            crossed := true
            if internal
                smc_a.intBullOB := true
            else
                smc_a.swBullOB  := true
        if crossed
            array<box> bxs = internal ? intOBBoxes : swOBBoxes
            if idx < bxs.size()
                bxs.get(idx).delete()
                bxs.remove(idx)
            obs.remove(idx)

smc_storeOB(smc_pivot p_, bool internal=false, int bias) =>
    if (not internal and smc_showSwOB) or (internal and smc_showIntOB)
        array<float> arr = na
        int pIdx = na
        if bias == smc_BEARISH
            arr  := parsedHighs.slice(p_.barIndex, bar_index)
            pIdx := p_.barIndex + arr.indexof(arr.max())
        else
            arr  := parsedLows.slice(p_.barIndex, bar_index)
            pIdx := p_.barIndex + arr.indexof(arr.min())
        ob = smc_orderBlock.new(parsedHighs.get(pIdx), parsedLows.get(pIdx), timesArr.get(pIdx), bias)
        array<smc_orderBlock> obs = internal ? intOB : swOB
        if obs.size() >= 100
            obs.pop()
        obs.unshift(ob)

smc_drawOBs(bool internal=false) =>
    array<smc_orderBlock> obs = internal ? intOB : swOB
    if obs.size() > 0
        maxOBs = internal ? smc_intOBSize : smc_swOBSize
        array<smc_orderBlock> sliced = obs.slice(0, math.min(maxOBs, obs.size()))
        for [idx, ob] in sliced
            color clr = smc_styleInput == smc_MONO ? (ob.bias == smc_BEARISH ? color.new(smc_MONO_BEAR,80) : color.new(smc_MONO_BULL,80)) : internal ? (ob.bias == smc_BEARISH ? smc_intBearOBClr : smc_intBullOBClr) : (ob.bias == smc_BEARISH ? smc_swBearOBClr : smc_swBullOBClr)
            array<box> bxs = internal ? intOBBoxes : swOBBoxes
            if idx < bxs.size()
                bxs.get(idx).delete()
            nb = box.new(ob.barTime, ob.barHigh, last_bar_time, ob.barLow, xloc=xloc.bar_time, extend=extend.right, bgcolor=clr, border_color=clr, text='OB', text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center, text_color=color.white)
            if idx < bxs.size()
                bxs.set(idx, nb)
            else
                bxs.push(nb)

smc_displayStruct(bool internal=false) =>
    var bool bullBar = true
    var bool bearBar = true
    if smc_intConfFilter
        bullBar := high - math.max(close,open) > math.min(close,open - low)
        bearBar := high - math.max(close,open) < math.min(close,open - low)

    smc_pivot p_  = internal ? internalHigh : swingHigh
    smc_trend tr_ = internal ? internalTrend : swingTrend
    string lst    = internal ? line.style_dashed : line.style_solid
    string lblSz  = internal ? smc_intLblSize : smc_swLblSize

    extra = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullBar : true
    bullClr = smc_styleInput == smc_MONO ? smc_MONO_BULL : internal ? smc_intBullClr : smc_swBullClr

    if ta.crossover(close, p_.currentLevel) and not p_.crossed and extra
        string tag = tr_.bias == smc_BEARISH ? smc_CHOCH : smc_BOS
        if internal
            smc_a.intBullCHoCH := tag == smc_CHOCH
            smc_a.intBullBOS   := tag == smc_BOS
        else
            smc_a.swBullCHoCH  := tag == smc_CHOCH
            smc_a.swBullBOS    := tag == smc_BOS
        p_.crossed := true
        tr_.bias := smc_BULLISH
        showInt = internal ? smc_showInternals and (smc_showIntBull == smc_ALL or (smc_showIntBull == smc_BOS and tag != smc_CHOCH) or (smc_showIntBull == smc_CHOCH and tag == smc_CHOCH)) : smc_showStructure and (smc_showSwBull == smc_ALL or (smc_showSwBull == smc_BOS and tag != smc_CHOCH) or (smc_showSwBull == smc_CHOCH and tag == smc_CHOCH))
        if showInt
            smc_drawStruct(p_, tag, bullClr, lst, label.style_label_down, lblSz)
        if (internal and smc_showIntOB) or (not internal and smc_showSwOB)
            smc_storeOB(p_, internal, smc_BULLISH)

    p_ := internal ? internalLow : swingLow
    extra := internal ? internalLow.currentLevel != swingLow.currentLevel and bearBar : true
    bearClr = smc_styleInput == smc_MONO ? smc_MONO_BEAR : internal ? smc_intBearClr : smc_swBearClr

    if ta.crossunder(close, p_.currentLevel) and not p_.crossed and extra
        string tag = tr_.bias == smc_BULLISH ? smc_CHOCH : smc_BOS
        if internal
            smc_a.intBearCHoCH := tag == smc_CHOCH
            smc_a.intBearBOS   := tag == smc_BOS
        else
            smc_a.swBearCHoCH  := tag == smc_CHOCH
            smc_a.swBearBOS    := tag == smc_BOS
        p_.crossed := true
        tr_.bias := smc_BEARISH
        showInt = internal ? smc_showInternals and (smc_showIntBear == smc_ALL or (smc_showIntBear == smc_BOS and tag != smc_CHOCH) or (smc_showIntBear == smc_CHOCH and tag == smc_CHOCH)) : smc_showStructure and (smc_showSwBear == smc_ALL or (smc_showSwBear == smc_BOS and tag != smc_CHOCH) or (smc_showSwBear == smc_CHOCH and tag == smc_CHOCH))
        if showInt
            smc_drawStruct(p_, tag, bearClr, lst, label.style_label_up, lblSz)
        if (internal and smc_showIntOB) or (not internal and smc_showSwOB)
            smc_storeOB(p_, internal, smc_BEARISH)

smc_fvgBox(int lt, int rt, float tp, float bp, color clr) =>
    box.new(chart.point.new(lt, na, tp), chart.point.new(rt + smc_fvgExtend * (time-time[1]), na, bp), xloc=xloc.bar_time, border_color=clr, bgcolor=clr, text='FVG', text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center, text_color=color.white)

smc_deleteFVGs() =>
    for [idx, f] in fvgs
        if (low < f.bottom and f.bias == smc_BULLISH) or (high > f.top and f.bias == smc_BEARISH)
            f.topBox.delete()
            f.bottomBox.delete()
            fvgs.remove(idx)

smc_drawFVGs() =>
    [lc, lo, lt, ch, cl, ct, l2h, l2l] = request.security(syminfo.tickerid, smc_fvgTF, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead = barmerge.lookahead_on)
    bdp = (lc - lo) / (lo * 100)
    nt  = timeframe.change(smc_fvgTF)
    th  = smc_fvgAutoTh ? ta.cum(math.abs(nt ? bdp : 0)) / bar_index * 2 : 0
    bull = cl > l2h and lc > l2h and bdp > th and nt
    bear = ch < l2l and lc < l2l and -bdp > th and nt
    if bull
        smc_a.bullFVG := true
        fvgs.unshift(smc_fvg.new(cl, l2h, smc_BULLISH, smc_fvgBox(lt,ct,cl,math.avg(cl,l2h),smc_fvgBullColor), smc_fvgBox(lt,ct,math.avg(cl,l2h),l2h,smc_fvgBullColor)))
    if bear
        smc_a.bearFVG := true
        fvgs.unshift(smc_fvg.new(ch, l2l, smc_BEARISH, smc_fvgBox(lt,ct,ch,math.avg(ch,l2l),smc_fvgBearColor), smc_fvgBox(lt,ct,math.avg(ch,l2l),l2l,smc_fvgBearColor)))

smc_styleOf(string s) =>
    switch s
        smc_SOL => line.style_solid
        smc_DSH => line.style_dashed
        smc_DOT => line.style_dotted

smc_drawLevels(string tf, bool same, string st_, color clr) =>
    [tl_, bl_, lt_, rt_] = request.security(syminfo.tickerid, tf, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)
    float pTop = same ? high : tl_
    float pBot = same ? low  : bl_
    int   pLT  = same ? time : lt_
    int   pRT  = same ? time : rt_
    int   pTT  = time
    int   pBT  = time
    if not same
        li = timesArr.binary_search_rightmost(pLT)
        ri = timesArr.binary_search_rightmost(pRT)
        ta_ = timesArr.slice(li, ri)
        tA  = highsArr.slice(li, ri)
        bA  = lowsArr .slice(li, ri)
        pTT := ta_.size() > 0 ? ta_.get(tA.indexof(tA.max())) : smc_initTime
        pBT := ta_.size() > 0 ? ta_.get(bA.indexof(bA.min())) : smc_initTime
    var line  topL = line.new(na,na,na,na, xloc=xloc.bar_time, color=clr, style=smc_styleOf(st_))
    var line  botL = line.new(na,na,na,na, xloc=xloc.bar_time, color=clr, style=smc_styleOf(st_))
    var label topLb= label.new(na,na, xloc=xloc.bar_time, text=str.format('P{0}H',tf), color=color(na), textcolor=clr, size=size.small, style=label.style_label_left)
    var label botLb= label.new(na,na, xloc=xloc.bar_time, text=str.format('P{0}L',tf), color=color(na), textcolor=clr, size=size.small, style=label.style_label_left)
    topL.set_first_point (chart.point.new(pTT, na, pTop))
    topL.set_second_point(chart.point.new(last_bar_time + 20*(time-time[1]), na, pTop))
    topLb.set_point      (chart.point.new(last_bar_time + 20*(time-time[1]), na, pTop))
    botL.set_first_point (chart.point.new(pBT, na, pBot))
    botL.set_second_point(chart.point.new(last_bar_time + 20*(time-time[1]), na, pBot))
    botLb.set_point      (chart.point.new(last_bar_time + 20*(time-time[1]), na, pBot))

smc_higherTF(string tf) => timeframe.in_seconds() > timeframe.in_seconds(tf)

smc_updTrail() =>
    trailing.top := math.max(high, trailing.top)
    trailing.lastTopTime := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

smc_drawHLSwings() =>
    var line  topL = line.new(na,na,na,na, color=smc_swBearColor, xloc=xloc.bar_time)
    var line  botL = line.new(na,na,na,na, color=smc_swBullColor, xloc=xloc.bar_time)
    var label topLb= label.new(na,na, color=color(na), textcolor=smc_swBearColor, xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny)
    var label botLb= label.new(na,na, color=color(na), textcolor=smc_swBullColor, xloc=xloc.bar_time, style=label.style_label_up,   size=size.tiny)
    rt = last_bar_time + 20 * (time - time[1])
    topL.set_first_point (chart.point.new(trailing.lastTopTime, na, trailing.top))
    topL.set_second_point(chart.point.new(rt, na, trailing.top))
    topLb.set_point      (chart.point.new(rt, na, trailing.top))
    topLb.set_text       (swingTrend.bias == smc_BEARISH ? 'Strong High' : 'Weak High')
    botL.set_first_point (chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    botL.set_second_point(chart.point.new(rt, na, trailing.bottom))
    botLb.set_point      (chart.point.new(rt, na, trailing.bottom))
    botLb.set_text       (swingTrend.bias == smc_BULLISH ? 'Strong Low' : 'Weak Low')

smc_drawZone(float lvl, int li, float t_, float b_, string tag, color clr, string st_) =>
    var label l_ = label.new(na,na, text=tag, color=color(na), textcolor=clr, style=st_, size=size.small)
    var box   bx = box.new(na,na,na,na, bgcolor=color.new(clr,80), border_color=color(na), xloc=xloc.bar_time)
    bx.set_top_left_point    (chart.point.new(trailing.barTime, na, t_))
    bx.set_bottom_right_point(chart.point.new(last_bar_time   , na, b_))
    l_.set_point             (chart.point.new(na, li, lvl))

smc_drawPD() =>
    smc_drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', smc_premColor, label.style_label_down)
    eq = math.avg(trailing.top, trailing.bottom)
    smc_drawZone(eq, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', smc_eqClr, label.style_label_left)
    smc_drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', smc_discColor, label.style_label_up)

smc_drawLV() =>
    per = smc_lqMode == 'Present' ? last_bar_index - b.i <= smc_lqBack : true
    atrV = ta.atr(144) * smc_lqTH
    if per
        bull = (b.l - b.h[2]) > atrV and b.l > b.h[2] and b.c[1] > b.h[2]
        if bull
            if smc_lqTX
                array.push(lqV, box.new(b.i - 2, b.l, b.i, b.h[2], na, text='FVG', text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center, text_color=color.white, bgcolor=smc_lqBC))
            else
                array.push(lqV, box.new(b.i - 2, b.l, b.i, b.h[2], na, bgcolor=smc_lqBC))
        bear = (b.l[2] - b.h) > atrV and b.h < b.l[2] and b.c[1] < b.l[2]
        if bear
            if smc_lqTX
                array.push(lqV, box.new(b.i - 2, b.l[2], b.i, b.h, na, text='FVG', text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center, text_color=color.white, bgcolor=smc_lqSC))
            else
                array.push(lqV, box.new(b.i - 2, b.l[2], b.i, b.h, na, bgcolor=smc_lqSC))

smc_manageLV() =>
    if lqV.size() > 0
        qt = lqV.size()
        for bn = qt - 1 to 0
            if bn < lqV.size()
                cb = lqV.get(bn)
                tBX = cb.get_top()
                bBX = cb.get_bottom()
                if b.h > bBX and b.l < tBX
                    if smc_lqVF
                        cb.set_bgcolor(smc_lqFC)
                        cb.set_text('')
                    else
                        cb.delete()
                    lqV.remove(bn)
                else
                    cb.set_right(b.i + 1)
                    if b.i - cb.get_left() > 21
                        cb.set_text_color(chart.fg_color)
        if lqV.size() > 500
            lqV.shift()

// ── execution
smc_pOpen   = en_smc and smc_showTrend ? open : na
smc_candClr = internalTrend.bias == smc_BULLISH ? smc_swBullColor : smc_swBearColor
plotcandle(smc_pOpen, high, low, close, color=smc_candClr, wickcolor=smc_candClr, bordercolor=smc_candClr)

if en_smc
    if smc_showHLSwings or smc_showPD
        smc_updTrail()
        if smc_showHLSwings
            smc_drawHLSwings()
        if smc_showPD
            smc_drawPD()
    if smc_showFVG
        smc_deleteFVGs()
    smc_getStruct(smc_swLength, false)
    smc_getStruct(5, false, true)
    if smc_showEQ
        smc_getStruct(smc_eqLength, true)
    if smc_showInternals or smc_showIntOB or smc_showTrend
        smc_displayStruct(true)
    if smc_showStructure or smc_showSwOB or smc_showHLSwings
        smc_displayStruct()
    if smc_showIntOB
        smc_deleteOB(true)
    if smc_showSwOB
        smc_deleteOB()
    if smc_showFVG
        smc_drawFVGs()
    smc_drawLV()
    smc_manageLV()

    smc_lastBI := smc_curBI
    smc_curBI  := bar_index
    newBar = smc_curBI != smc_lastBI

    if barstate.islastconfirmedhistory or barstate.islast
        if smc_showIntOB
            smc_drawOBs(true)
        if smc_showSwOB
            smc_drawOBs()
    if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
        if smc_showDaily   and not smc_higherTF('D')
            smc_drawLevels('D', timeframe.isdaily,   smc_dStyle, smc_dColor)
        if smc_showWeekly  and not smc_higherTF('W')
            smc_drawLevels('W', timeframe.isweekly,  smc_wStyle, smc_wColor)
        if smc_showMonthly and not smc_higherTF('M')
            smc_drawLevels('M', timeframe.ismonthly, smc_mStyle, smc_mColor)

alertcondition(smc_a.intBullBOS  , 'SMC: Internal Bullish BOS'  , 'Internal Bullish BOS formed')
alertcondition(smc_a.intBullCHoCH, 'SMC: Internal Bullish CHoCH', 'Internal Bullish CHoCH formed')
alertcondition(smc_a.intBearBOS  , 'SMC: Internal Bearish BOS'  , 'Internal Bearish BOS formed')
alertcondition(smc_a.intBearCHoCH, 'SMC: Internal Bearish CHoCH', 'Internal Bearish CHoCH formed')
alertcondition(smc_a.swBullBOS   , 'SMC: Bullish BOS'           , 'Bullish BOS formed')
alertcondition(smc_a.swBullCHoCH , 'SMC: Bullish CHoCH'         , 'Bullish CHoCH formed')
alertcondition(smc_a.swBearBOS   , 'SMC: Bearish BOS'           , 'Bearish BOS formed')
alertcondition(smc_a.swBearCHoCH , 'SMC: Bearish CHoCH'         , 'Bearish CHoCH formed')
alertcondition(smc_a.bullFVG     , 'SMC: Bullish FVG'           , 'Bullish FVG formed')
alertcondition(smc_a.bearFVG     , 'SMC: Bearish FVG'           , 'Bearish FVG formed')


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (3) TRENDLINES WITH BREAKS — © LuxAlgo  [v5 → v6]
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G3 = '③  Trendlines with Breaks'
tl_length    = input.int  (14    , 'Swing Lookback'        , group = G3)
tl_mult      = input.float(1.    , 'Slope'                 , minval=0, step=.1, group = G3)
tl_calcMth   = input.string('Atr', 'Slope Calc Method'     , options=['Atr','Stdev','Linreg'], group = G3)
tl_backpaint = input.bool (true  , 'Backpaint'             , group = G3)
tl_upCss     = input.color(color.teal, 'Up Trendline Color', group = G3)
tl_dnCss     = input.color(color.red , 'Dn Trendline Color', group = G3)
tl_showExt   = input.bool (true  , 'Show Extended Lines'   , group = G3)

var float tl_upper = 0.
var float tl_lower = 0.
var float tl_sph   = 0.
var float tl_spl   = 0.
var int   tl_offset = tl_backpaint ? tl_length : 0

tl_n   = bar_index
tl_src = close
tl_ph  = ta.pivothigh(tl_length, tl_length)
tl_pl  = ta.pivotlow (tl_length, tl_length)

tl_slope = switch tl_calcMth
    'Atr'    => ta.atr(tl_length) / tl_length * tl_mult
    'Stdev'  => ta.stdev(tl_src, tl_length) / tl_length * tl_mult
    'Linreg' => math.abs(ta.sma(tl_src * tl_n, tl_length) - ta.sma(tl_src, tl_length) * ta.sma(tl_n, tl_length)) / ta.variance(tl_n, tl_length) / 2 * tl_mult

tl_sph := tl_ph ? tl_slope : tl_sph
tl_spl := tl_pl ? tl_slope : tl_spl
tl_upper := tl_ph ? tl_ph : tl_upper - tl_sph
tl_lower := tl_pl ? tl_pl : tl_lower + tl_spl

var int tl_upos = 0
var int tl_dnos = 0
tl_upos := tl_ph ? 0 : close > tl_upper - tl_sph * tl_length ? 1 : tl_upos
tl_dnos := tl_pl ? 0 : close < tl_lower + tl_spl * tl_length ? 1 : tl_dnos

var line tl_uptl = line.new(na,na,na,na, color=tl_upCss, style=line.style_dashed, extend=extend.right)
var line tl_dntl = line.new(na,na,na,na, color=tl_dnCss, style=line.style_dashed, extend=extend.right)

if en_tl and tl_ph and tl_showExt
    tl_uptl.set_xy1(tl_n - tl_offset    , tl_backpaint ? tl_ph             : tl_upper - tl_sph * tl_length)
    tl_uptl.set_xy2(tl_n - tl_offset + 1, tl_backpaint ? tl_ph - tl_slope  : tl_upper - tl_sph * (tl_length + 1))
if en_tl and tl_pl and tl_showExt
    tl_dntl.set_xy1(tl_n - tl_offset    , tl_backpaint ? tl_pl             : tl_lower + tl_spl * tl_length)
    tl_dntl.set_xy2(tl_n - tl_offset + 1, tl_backpaint ? tl_pl + tl_slope  : tl_lower + tl_spl * (tl_length + 1))

plot(en_tl ? (tl_backpaint ? tl_upper : tl_upper - tl_sph * tl_length) : na, 'TL Upper', color = tl_ph ? na : tl_upCss, offset = -tl_offset)
plot(en_tl ? (tl_backpaint ? tl_lower : tl_lower + tl_spl * tl_length) : na, 'TL Lower', color = tl_pl ? na : tl_dnCss, offset = -tl_offset)

plotshape(en_tl and tl_upos > tl_upos[1] ? low  : na, 'TL Upper Break', shape.labelup,   location.absolute, tl_upCss, text='B', textcolor=color.white, size=size.tiny)
plotshape(en_tl and tl_dnos > tl_dnos[1] ? high : na, 'TL Lower Break', shape.labeldown, location.absolute, tl_dnCss, text='B', textcolor=color.white, size=size.tiny)

alertcondition(tl_upos > tl_upos[1], 'TL: Upward Breakout'  , 'Price broke down-trendline upward')
alertcondition(tl_dnos > tl_dnos[1], 'TL: Downward Breakout', 'Price broke up-trendline downward')


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (4) SUPPORT & RESISTANCE LEVELS WITH BREAKS — © LuxAlgo / profitgang
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G4 = '④  S/R Levels with Breaks'
srb_toggleBreaks = input.bool(true, 'Show Breaks'      , group = G4)
srb_leftBars     = input.int (15  , 'Left Bars'        , group = G4)
srb_rightBars    = input.int (15  , 'Right Bars'       , group = G4)
srb_volThresh    = input.int (20  , 'Volume Threshold' , group = G4)

srb_highPivot = fixnan(ta.pivothigh(srb_leftBars, srb_rightBars)[1])
srb_lowPivot  = fixnan(ta.pivotlow (srb_leftBars, srb_rightBars)[1])

plot(en_srb ? srb_highPivot : na, 'SRB Resistance', color = ta.change(srb_highPivot) != 0 ? na : #FF0000, linewidth = 3, offset = -(srb_rightBars + 1))
plot(en_srb ? srb_lowPivot  : na, 'SRB Support'   , color = ta.change(srb_lowPivot ) != 0 ? na : #233dee, linewidth = 3, offset = -(srb_rightBars + 1))

srb_short = ta.ema(volume, 5)
srb_long  = ta.ema(volume, 10)
srb_osc   = 100 * (srb_short - srb_long) / srb_long

plotshape(en_srb and srb_toggleBreaks and ta.crossunder(close, srb_lowPivot ) and not (open - close < high - open) and srb_osc > srb_volThresh, 'SRB SELL'    , shape.labeldown, location.abovebar, color.red  , text='SELL'     , textcolor=color.white, size=size.tiny)
plotshape(en_srb and srb_toggleBreaks and ta.crossover (close, srb_highPivot) and not (open - low > close - open ) and srb_osc > srb_volThresh, 'SRB BUY'     , shape.labelup  , location.belowbar, color.green, text='BUY'      , textcolor=color.white, size=size.tiny)
plotshape(en_srb and srb_toggleBreaks and ta.crossover (close, srb_highPivot) and (open - low > close - open)                                  , 'SRB BullWick', shape.labelup  , location.belowbar, color.green, text='Bull Wick', textcolor=color.white, size=size.tiny)
plotshape(en_srb and srb_toggleBreaks and ta.crossunder(close, srb_lowPivot ) and (open - close < high - open)                                 , 'SRB BearWick', shape.labeldown, location.abovebar, color.red  , text='Bear Wick', textcolor=color.white, size=size.tiny)

alertcondition(ta.crossunder(close, srb_lowPivot ) and srb_osc > srb_volThresh, 'SRB: Support Broken'   , 'Support Broken')
alertcondition(ta.crossover (close, srb_highPivot) and srb_osc > srb_volThresh, 'SRB: Resistance Broken', 'Resistance Broken')


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (5) WYCKOFF EVENT DETECTION — © AlphaExtract  (kept as-is, gated by en_we)
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G5_GEN  = '⑤  Wyckoff Events – General'
G5_RNG  = '⑤  Wyckoff Events – Trading Range'
G5_PHS  = '⑤  Wyckoff Events – Phase'
G5_SEN  = '⑤  Wyckoff Events – Sensitivity'
G5_FLT  = '⑤  Wyckoff Events – Filters'
G5_AL   = '⑤  Wyckoff Events – Alerts'

we_volLen           = input.int  (20 , 'Volume MA Length', minval=1, group=G5_GEN)
we_priceLookback    = input.int  (20 , 'Price Pattern Lookback', minval=5, group=G5_GEN)
we_lineLength       = input.int  (15 , 'Line Length', minval=5, group=G5_GEN)
we_labelSpacing     = input.int  (5  , 'Min Label Spacing', minval=1, maxval=20, group=G5_GEN)
we_boxScale         = input.float(0.01, 'Box Scale Factor', minval=0.001, step=0.001, group='⑤  Visual')

we_showRange        = input.bool (true, 'Show Trading Range', group=G5_RNG)
we_rangeStyle       = input.string('Pivot-based', 'Range Style', options=['Dynamic','Fixed','Pivot-based'], group=G5_RNG)
we_fixedRangeBars   = input.int  (50 , 'Fixed Range Bars'   , minval=10, maxval=500, group=G5_RNG)
we_pivotStrength    = input.int  (3  , 'Pivot Strength'     , minval=1, maxval=10, group=G5_RNG)
we_pivotLookback    = input.int  (100, 'Pivot Lookback'     , minval=20, maxval=500, group=G5_RNG)
we_rangeExtend      = input.int  (50 , 'Extend Range'       , minval=0, maxval=500, group=G5_RNG)
we_rangeOpacity     = input.int  (5  , 'Range Opacity %'    , minval=0, maxval=100, group=G5_RNG)
we_rangeColor       = input.color(color.new(#7B68EE, 0), 'Range Color', group=G5_RNG)
we_rangeBorderWidth = input.int  (2  , 'Range Border Width' , minval=1, maxval=5, group=G5_RNG)

we_phaseStrengthMul = input.float(2.0, 'Phase Strength Multiplier', minval=1.0, maxval=5.0, step=0.1, group=G5_PHS)
we_phaseWindowBars  = input.int  (20 , 'Phase Analysis Window'    , minval=10, maxval=100, group=G5_PHS)

we_volThreshMult    = input.float(2.0, 'Volume Threshold Multiplier', minval=1.0, step=0.1, group=G5_SEN)
we_priceThreshMult  = input.float(0.3, 'Price Movement Threshold', minval=0.1, maxval=1.0, step=0.1, group=G5_SEN)
we_trendStrength    = input.int  (3  , 'Trend Strength', minval=1, maxval=10, group=G5_SEN)
we_minBarsNoSig     = input.int  (5  , 'Min Bars Between Events', minval=1, maxval=50, group=G5_SEN)

we_volumeFilter     = input.float(1.5, 'Volume Filter'      , minval=1.0, maxval=5.0, step=0.1, group=G5_FLT)
we_priceRangeFilter = input.float(0.5, 'Price Range Filter' , minval=0.1, maxval=1.0, step=0.1, group=G5_FLT)

we_enableAlerts     = input.bool (true , 'Enable Alerts'                  , group=G5_AL)
we_alertOnLabels    = input.bool (false, 'Only Alert When Label Created'  , group=G5_AL)

var array<int>   we_labelBars   = array.new<int>()
var array<float> we_labelPrices = array.new<float>()
var int we_maxLabels = 50

var int we_lastPSY=0, we_lastUTD=0, we_lastLPSY=0, we_lastSOW=0, we_lastBC=0, we_lastSTD=0, we_lastBUEC=0
var int we_lastPS=0, we_lastSC=0, we_lastARA=0, we_lastSOS=0, we_lastLPS=0, we_lastSpring=0, we_lastSTA=0, we_lastJAC=0, we_lastTSO=0

we_canAlert(lastBar) => bar_index - lastBar >= we_minBarsNoSig

we_hasNearbyLabel(int cb, float cp) =>
    bool ov = false
    if we_labelBars.size() > 0 and cp != 0
        for i = 0 to we_labelBars.size() - 1
            pb = we_labelBars.get(i)
            pp = we_labelPrices.get(i)
            if math.abs(cb - pb) < we_minBarsNoSig and math.abs(cp - pp) / cp < we_priceRangeFilter
                ov := true
                break
    ov

we_track(int bb, float pp) =>
    if we_labelBars.size() >= we_maxLabels
        we_labelBars.shift()
        we_labelPrices.shift()
    we_labelBars.push(bb)
    we_labelPrices.push(pp)

we_isPivotHigh(int len) =>
    bool result = false
    int MAX = 20
    if len >= we_pivotStrength and len <= MAX and bar_index >= (len + we_pivotStrength)
        result := true
        for i = 1 to we_pivotStrength
            fwd = len + i
            bwd = len - i
            if fwd <= MAX and bwd >= 0
                if high[len] <= high[fwd] or high[len] <= high[bwd]
                    result := false
                    break
            else
                result := false
                break
    result

we_isPivotLow(int len) =>
    bool result = false
    int MAX = 20
    if len >= we_pivotStrength and len <= MAX and bar_index >= (len + we_pivotStrength)
        result := true
        for i = 1 to we_pivotStrength
            fwd = len + i
            bwd = len - i
            if fwd <= MAX and bwd >= 0
                if low[len] >= low[fwd] or low[len] >= low[bwd]
                    result := false
                    break
            else
                result := false
                break
    result

we_volMA       = ta.sma(volume, we_volLen)
we_highestHigh = ta.highest(high, we_priceLookback)
we_lowestLow   = ta.lowest (low , we_priceLookback)
we_avgTR       = ta.atr(we_priceLookback)

color we_cPSY  = color.new(#FF6B6B, 0)
color we_cUTD  = color.new(#FFA500, 0)
color we_cLPSY = color.new(#FF4141, 0)
color we_cSOW  = color.new(#FF0000, 0)
color we_cBC   = color.new(#FF7F00, 0)
color we_cSTD  = color.new(#FFA07A, 0)
color we_cBUEC = color.new(#FF6347, 0)
color we_cPS   = color.new(#4CAF50, 0)
color we_cSC   = color.new(#45B39D, 0)
color we_cARA  = color.new(#2ECC71, 0)
color we_cSOS  = color.new(#27AE60, 0)
color we_cLPS  = color.new(#229954, 0)
color we_cSPR  = color.new(#00FA9A, 0)
color we_cSTA  = color.new(#66CDAA, 0)
color we_cJAC  = color.new(#32CD32, 0)
color we_cTSO  = color.new(#008000, 0)

float we_lblOff = (high - low) * 0.1
float we_boxOff = (high - low) * we_boxScale

var int    we_bearCount = 0
var int    we_bullCount = 0
var string we_prevPhase = 'NEUTRAL'
var string we_curPhase  = 'NEUTRAL'

we_getCurrentPhase() =>
    if we_bearCount > we_bullCount * we_phaseStrengthMul
        'DISTRIBUTION'
    else if we_bullCount > we_bearCount * we_phaseStrengthMul
        'ACCUMULATION'
    else
        'NEUTRAL'

we_createLabel(bool cond, float price, string txt, color clr, bool isTop, string tip) =>
    bool created = false
    if cond and not we_hasNearbyLabel(bar_index, price)
        box.new(bar_index - we_lineLength, price + we_boxOff, bar_index, price - we_boxOff, border_color=clr, bgcolor=clr, border_style=line.style_solid)
        box.new(bar_index, price + (we_boxOff * 10), bar_index + 1, price - (we_boxOff * 10), border_color=clr, bgcolor=clr, border_style=line.style_solid)
        label.new(bar_index, price + (isTop ? we_lblOff : -we_lblOff), txt, style = isTop ? label.style_label_down : label.style_label_up, color=color.new(color.black,100), textcolor=clr, size=size.small, tooltip=tip)
        we_track(bar_index, price)
        created := true
    created

we_phase = we_getCurrentPhase()
if barstate.isconfirmed
    we_prevPhase := we_curPhase
    we_curPhase  := we_phase

// ── conditions
we_psy   = high > we_highestHigh[1] and volume > we_volMA * we_volThreshMult and close < high - (high-low) * we_priceThreshMult and ta.falling(close, we_trendStrength)
we_utd   = we_phase == 'DISTRIBUTION' and high > we_highestHigh[1] and close < open and volume > we_volMA * we_volumeFilter and high - close > we_avgTR * we_priceThreshMult
we_lpsy  = high > high[1] and close < open and volume < we_volMA * we_volumeFilter and ta.falling(close, we_trendStrength)
we_sow   = close < open and low < we_lowestLow[1] and volume > we_volMA * we_volThreshMult and ta.falling(close, we_trendStrength)
we_bc    = high > we_highestHigh[2] and volume > we_volMA * (we_volThreshMult * 1.5) and close > open and (close-open)/(high-low) > 0.6
we_std   = we_phase == 'DISTRIBUTION' and high > high[1] and high >= we_highestHigh[5] * 0.98 and high <= we_highestHigh[5] * 1.02 and volume < we_volMA and volume < volume[1] * 0.8

var bool we_buec = false
we_buec := false
for i = 1 to 5
    if we_utd[i]
        we_buec := close < open and high < high[i] and close > low + (high-low) * 0.3 and volume < volume[i]
        break

we_ps    = low < we_lowestLow[1] and volume > we_volMA * we_volThreshMult and close > low + (high-low) * we_priceThreshMult and ta.falling(close, we_trendStrength)
we_sc    = low < we_lowestLow[1] and volume > we_volMA * (we_volThreshMult * 1.2) and close > low + (high-low) * (we_priceThreshMult * 1.5)
we_ara   = we_phase == 'ACCUMULATION' and close > open and high > we_highestHigh[we_trendStrength] and volume < we_volMA * we_volumeFilter and ta.rising(close, we_trendStrength)
we_sos   = close > open and high > we_highestHigh[1] and volume > we_volMA * we_volThreshMult and ta.rising(close, we_trendStrength)
we_lps   = low > low[1] and close > open and volume < we_volMA * we_volumeFilter and ta.rising(close, we_trendStrength)
we_spr   = low < we_lowestLow[3] and close > open and close > low + (high-low) * 0.6 and volume > we_volMA * we_volumeFilter
we_sta   = we_phase == 'ACCUMULATION' and low < low[1] and low >= we_lowestLow[5] * 0.98 and low <= we_lowestLow[5] * 1.02 and volume < we_volMA and volume < volume[1] * 0.8
we_jac   = close > open and close > we_highestHigh[3] and volume > we_volMA * we_volThreshMult and ta.rising(close, we_trendStrength + 1)
we_tso   = low < we_lowestLow[2] and close > open and close > low + (high-low) * 0.7 and volume > we_volMA * (we_volThreshMult * 1.2) and ta.rising(close, we_trendStrength + 2)

if en_we
    if we_psy or we_utd or we_lpsy or we_sow or we_bc or we_std or we_buec
        we_bearCount := we_bearCount + 1
    if we_ps or we_sc or we_ara or we_sos or we_lps or we_spr or we_sta or we_jac or we_tso
        we_bullCount := we_bullCount + 1
    if bar_index % we_phaseWindowBars == 0
        we_bearCount := 0
        we_bullCount := 0

we_phaseColor(string p) =>
    switch p
        'DISTRIBUTION' => color.new(#FF6B6B, 0)
        'ACCUMULATION' => color.new(#4CAF50, 0)
        => color.new(color.gray, 0)

we_phaseStrength() =>
    sr = math.abs(we_bullCount - we_bearCount) / math.max(we_bullCount + we_bearCount, 1)
    sr > 0.7 ? 'STRONG' : sr > 0.3 ? 'MODERATE' : 'WEAK'

we_pricePos() =>
    if high >= we_highestHigh[3] and close < open
        'UPTHRUST ZONE'
    else if low <= we_lowestLow[3] and close > open
        'SPRING ZONE'
    else if high >= we_highestHigh[5]
        'AT RESISTANCE'
    else if low <= we_lowestLow[5]
        'AT SUPPORT'
    else
        'TRADING RANGE'

we_supplyDemand() =>
    if volume > we_volMA * 1.5 and close > open
        'DEMAND DOMINANT'
    else if volume > we_volMA * 1.5 and close < open
        'SUPPLY DOMINANT'
    else
        'IN BALANCE'

var table we_tbl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 1), border_width=2, border_color=#000000)
if barstate.islast and en_we
    pv = we_getCurrentPhase()
    pc = we_phaseColor(pv)
    table.cell(we_tbl, 0, 0, '💎 MARKET PHASE 💎', text_color=color.rgb(0,0,0), text_size=size.large , bgcolor=color.rgb(80,149,252))
    table.cell(we_tbl, 1, 0, pv                  , text_color=pc              , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 0, 1, '- Strength -'       , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 1, 1, we_phaseStrength()   , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 0, 2, '- Position -'       , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 1, 2, we_pricePos()        , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 0, 3, '- S/D state -'      , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    table.cell(we_tbl, 1, 3, we_supplyDemand()    , text_color=color.white     , text_size=size.normal, bgcolor=color.new(color.black, 0))
    if we_showRange
        table.cell(we_tbl, 0, 4, '- Range -', text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black, 0))
        var float upR = na
        var float loR = na
        if we_rangeStyle == 'Dynamic'
            upR := we_highestHigh
            loR := we_lowestLow
        else if we_rangeStyle == 'Fixed'
            upR := ta.highest(high, we_fixedRangeBars)
            loR := ta.lowest (low , we_fixedRangeBars)
        else
            float lpH = we_highestHigh
            float lpL = we_lowestLow
            int MAX = 20
            mx = math.min(math.min(we_pivotLookback, MAX), bar_index - we_pivotStrength - 1)
            if mx > 5
                for i = 5 to mx
                    if we_isPivotHigh(i)
                        lpH := high[i]
                        break
                for i = 5 to mx
                    if we_isPivotLow(i)
                        lpL := low[i]
                        break
            upR := lpH
            loR := lpL
        rText = str.tostring(math.round((upR - loR) / loR * 100, 2)) + '%'
        table.cell(we_tbl, 1, 4, rText, text_color=color.new(we_rangeColor, 0), text_size=size.normal, bgcolor=color.new(color.black, 0))

var box we_rangeBox = na
if en_we and we_showRange and barstate.islast
    if not na(we_rangeBox)
        box.delete(we_rangeBox)
    var float ub = na
    var float lb = na
    var int   sp = 0
    if we_rangeStyle == 'Dynamic'
        ub := we_highestHigh
        lb := we_lowestLow
        sp := bar_index - we_priceLookback
    else if we_rangeStyle == 'Fixed'
        float hh = -1e10
        float ll =  1e10
        int MAX = 20
        sl = math.min(math.min(we_fixedRangeBars, MAX), bar_index)
        for i = 0 to sl - 1
            if i <= MAX
                hh := math.max(hh, high[i])
                ll := math.min(ll, low [i])
        ub := hh
        lb := ll
        sp := bar_index - sl
    else
        float lpH = we_highestHigh
        float lpL = we_lowestLow
        int phB = bar_index - we_priceLookback
        int plB = bar_index - we_priceLookback
        int MAX = 20
        mx = math.min(math.min(we_pivotLookback, MAX), bar_index - we_pivotStrength - 1)
        if mx > 5
            for i = 5 to mx
                if we_isPivotHigh(i)
                    lpH := high[i]
                    phB := bar_index - i
                    break
            for i = 5 to mx
                if we_isPivotLow(i)
                    lpL := low[i]
                    plB := bar_index - i
                    break
        ub := lpH
        lb := lpL
        sp := math.min(phB, plB)
    rc = color.new(we_rangeColor, we_rangeOpacity)
    we_rangeBox := box.new(left=sp, top=ub, right=bar_index + we_rangeExtend, bottom=lb, bgcolor=color.new(we_rangeColor, 95), border_color=rc, border_width=we_rangeBorderWidth, border_style=line.style_dashed)

bool we_lc_psy=false, we_lc_utd=false, we_lc_lpsy=false, we_lc_sow=false, we_lc_bc=false, we_lc_std=false, we_lc_buec=false
bool we_lc_ps=false , we_lc_sc=false , we_lc_ara=false , we_lc_sos=false, we_lc_lps=false, we_lc_spr=false, we_lc_sta=false, we_lc_jac=false, we_lc_tso=false

if en_we
    if we_psy
        we_lc_psy := we_createLabel(we_psy, high, 'PSY', we_cPSY, true, '🔴 PSY - Preliminary Supply\nالعرض الأولي - بداية التوزيع المحتملة')
    if we_utd
        we_lc_utd := we_createLabel(we_utd, high, 'UT-D', we_cUTD, true, '🟠 UT-D - Upthrust in Distribution\nالدفع الصاعد في التوزيع - فخ للمشترين')
    if we_lpsy
        we_lc_lpsy := we_createLabel(we_lpsy, high, 'LPSY', we_cLPSY, true, '🔴 LPSY - Last Point of Supply\nآخر نقطة عرض قبل الهبوط')
    if we_sow
        we_lc_sow := we_createLabel(we_sow, low, 'SOW', we_cSOW, false, '🔴 SOW - Sign of Weakness\nعلامة الضعف وفشل الطلب')
    if we_bc
        we_lc_bc := we_createLabel(we_bc, high, 'BC', we_cBC, true, '🟠 BC - Buying Climax\nذروة الشراء واستنزاف الطلب')
    if we_std
        we_lc_std := we_createLabel(we_std, high, 'ST-D', we_cSTD, true, '🟠 ST-D - Secondary Test in Distribution\nاختبار ثانوي في التوزيع')
    if we_buec
        we_lc_buec := we_createLabel(we_buec, high, 'BUEC', we_cBUEC, true, '🟠 BUEC - Backup After Upthrust\nارتداد ضعيف بعد UT')
    if we_ps
        we_lc_ps := we_createLabel(we_ps, low, 'PS', we_cPS, false, '🟢 PS - Preliminary Support\nالدعم الأولي - بداية التجميع المحتملة')
    if we_sc
        we_lc_sc := we_createLabel(we_sc, low, 'SC', we_cSC, false, '🟢 SC - Selling Climax\nذروة البيع واستنزاف العرض')
    if we_ara
        we_lc_ara := we_createLabel(we_ara, high, 'AR-A', we_cARA, true, '🟢 AR-A - Automatic Rally in Accumulation\nارتداد تلقائي في التجميع')
    if we_sos
        we_lc_sos := we_createLabel(we_sos, high, '【SOS】', we_cSOS, true, '🟢 SOS - Sign of Strength\nعلامة القوة وظهور الطلب')
    if we_lps
        we_lc_lps := we_createLabel(we_lps, low, 'LPS', we_cLPS, false, '🟢 LPS - Last Point of Support\nآخر نقطة دعم قبل الصعود')
    if we_spr
        we_lc_spr := we_createLabel(we_spr, low, 'SPRING', we_cSPR, false, '🟢 SPRING - النابض\nكسر كاذب للدعم وإشارة صعودية قوية')
    if we_sta
        we_lc_sta := we_createLabel(we_sta, low, 'ST-A', we_cSTA, false, '🟢 ST-A - Secondary Test in Accumulation\nاختبار ثانوي في التجميع')
    if we_jac
        we_lc_jac := we_createLabel(we_jac, high, 'JAC', we_cJAC, true, '🟢 JAC - Jump Across the Creek\nقفزة عبر الجدول - كسر قوي للمقاومة')
    if we_tso
        we_lc_tso := we_createLabel(we_tso, low, 'TSO', we_cTSO, false, '🟢 TSO - Terminal Shakeout\nاهتزاز نهائي قبل الصعود القوي')

// ── alerts (kept from original – fire when condition + cooldown)
we_alertCond_psy  = en_we and we_enableAlerts and we_psy  and we_canAlert(we_lastPSY ) and (not we_alertOnLabels or we_lc_psy )
we_alertCond_utd  = en_we and we_enableAlerts and we_utd  and we_canAlert(we_lastUTD ) and (not we_alertOnLabels or we_lc_utd )
we_alertCond_lpsy = en_we and we_enableAlerts and we_lpsy and we_canAlert(we_lastLPSY) and (not we_alertOnLabels or we_lc_lpsy)
we_alertCond_sow  = en_we and we_enableAlerts and we_sow  and we_canAlert(we_lastSOW ) and (not we_alertOnLabels or we_lc_sow )
we_alertCond_bc   = en_we and we_enableAlerts and we_bc   and we_canAlert(we_lastBC  ) and (not we_alertOnLabels or we_lc_bc  )
we_alertCond_std  = en_we and we_enableAlerts and we_std  and we_canAlert(we_lastSTD ) and (not we_alertOnLabels or we_lc_std )
we_alertCond_buec = en_we and we_enableAlerts and we_buec and we_canAlert(we_lastBUEC) and (not we_alertOnLabels or we_lc_buec)
we_alertCond_ps   = en_we and we_enableAlerts and we_ps   and we_canAlert(we_lastPS  ) and (not we_alertOnLabels or we_lc_ps  )
we_alertCond_sc   = en_we and we_enableAlerts and we_sc   and we_canAlert(we_lastSC  ) and (not we_alertOnLabels or we_lc_sc  )
we_alertCond_ara  = en_we and we_enableAlerts and we_ara  and we_canAlert(we_lastARA ) and (not we_alertOnLabels or we_lc_ara )
we_alertCond_sos  = en_we and we_enableAlerts and we_sos  and we_canAlert(we_lastSOS ) and (not we_alertOnLabels or we_lc_sos )
we_alertCond_lps  = en_we and we_enableAlerts and we_lps  and we_canAlert(we_lastLPS ) and (not we_alertOnLabels or we_lc_lps )
we_alertCond_spr  = en_we and we_enableAlerts and we_spr  and we_canAlert(we_lastSpring) and (not we_alertOnLabels or we_lc_spr)
we_alertCond_sta  = en_we and we_enableAlerts and we_sta  and we_canAlert(we_lastSTA ) and (not we_alertOnLabels or we_lc_sta )
we_alertCond_jac  = en_we and we_enableAlerts and we_jac  and we_canAlert(we_lastJAC ) and (not we_alertOnLabels or we_lc_jac )
we_alertCond_tso  = en_we and we_enableAlerts and we_tso  and we_canAlert(we_lastTSO ) and (not we_alertOnLabels or we_lc_tso )

if we_alertCond_psy
    we_lastPSY := bar_index
if we_alertCond_utd
    we_lastUTD := bar_index
if we_alertCond_lpsy
    we_lastLPSY := bar_index
if we_alertCond_sow
    we_lastSOW := bar_index
if we_alertCond_bc
    we_lastBC := bar_index
if we_alertCond_std
    we_lastSTD := bar_index
if we_alertCond_buec
    we_lastBUEC := bar_index
if we_alertCond_ps
    we_lastPS := bar_index
if we_alertCond_sc
    we_lastSC := bar_index
if we_alertCond_ara
    we_lastARA := bar_index
if we_alertCond_sos
    we_lastSOS := bar_index
if we_alertCond_lps
    we_lastLPS := bar_index
if we_alertCond_spr
    we_lastSpring := bar_index
if we_alertCond_sta
    we_lastSTA := bar_index
if we_alertCond_jac
    we_lastJAC := bar_index
if we_alertCond_tso
    we_lastTSO := bar_index

alertcondition(we_alertCond_psy , 'WE PSY' , '🔴 PSY detected')
alertcondition(we_alertCond_utd , 'WE UT-D', '🔴 UT-D detected')
alertcondition(we_alertCond_lpsy, 'WE LPSY', '🔴 LPSY detected')
alertcondition(we_alertCond_sow , 'WE SOW' , '🔴 SOW detected')
alertcondition(we_alertCond_bc  , 'WE BC'  , '🔴 BC detected')
alertcondition(we_alertCond_std , 'WE ST-D', '🔴 ST-D detected')
alertcondition(we_alertCond_buec, 'WE BUEC', '🔴 BUEC detected')
alertcondition(we_alertCond_ps  , 'WE PS'  , '🟢 PS detected')
alertcondition(we_alertCond_sc  , 'WE SC'  , '🟢 SC detected')
alertcondition(we_alertCond_ara , 'WE AR-A', '🟢 AR-A detected')
alertcondition(we_alertCond_sos , 'WE SOS' , '🟢 SOS detected')
alertcondition(we_alertCond_lps , 'WE LPS' , '🟢 LPS detected')
alertcondition(we_alertCond_spr , 'WE SPRING', '🟢 SPRING detected')
alertcondition(we_alertCond_sta , 'WE ST-A', '🟢 ST-A detected')
alertcondition(we_alertCond_jac , 'WE JAC' , '🟢 JAC detected')
alertcondition(we_alertCond_tso , 'WE TSO' , '🟢 TSO detected')


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (6) WYCKOFF ACCUMULATION/DISTRIBUTION  +  PHASES (A,B,C,D,E)  — © faytterro [v5 → v6, enhanced]
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G6 = '⑥  Wyckoff Accum/Dist + Phases'
wad_color    = input.color(color.white, 'Text Color', group = G6)
wad_rsilen   = input.int(14, 'RSI Length'       , group = G6)
wad_rsisens  = input.int(20, 'Trend Sensitivity', maxval=50, minval=0, group = G6,
     tooltip='كلما زادت الحساسية، قلّت إشارات الصعود/الهبوط وزادت إشارات الاتجاه الجانبي')
wad_pivotLen = input.int(5, 'Pivot Length', minval=1, group = G6)
wad_showPhases = input.bool(true, 'Show Wyckoff Phases (A-E) inside box', group = G6)

wad_rsi    = ta.rsi(close, wad_rsilen)
wad_utad   = wad_rsi < 50 + wad_rsisens and wad_rsi[1] > 50 + wad_rsisens
wad_spring = wad_rsi > 50 - wad_rsisens and wad_rsi[1] < 50 - wad_rsisens

wad_myHigh(int len) =>
    x = array.new_float()
    for i = 0 to len - 1
        x.push(high[i])
    x.max()

wad_myLow(int len) =>
    x = array.new_float()
    for i = 0 to len - 1
        x.push(low[i])
    x.min()

wad_side = (wad_rsi < 50 + wad_rsisens and wad_rsi > 50 - wad_rsisens) or (wad_rsi[1] < 50 + wad_rsisens and wad_rsi[1] > 50 - wad_rsisens)
wad_bull = wad_rsi > 50 + wad_rsisens and wad_rsi[1] > 50 + wad_rsisens
wad_bear = wad_rsi < 50 - wad_rsisens and wad_rsi[1] < 50 - wad_rsisens

wad_boxlen = ta.barssince(wad_side and not wad_side[1])
barcolor(en_wad and wad_bull ? color.lime : en_wad and wad_bear ? color.purple : na, offset = -2)

wad_x1 = ta.valuewhen(wad_side and not wad_side[1], bar_index, 0)
wad_x2 = ta.valuewhen(not wad_side and wad_side[1], bar_index[1], 0) - 1
wad_y1 = wad_myHigh(math.max(1, wad_boxlen + 1))[2]
wad_y2 = wad_myLow (math.max(1, wad_boxlen + 1))[2]

// ── Wyckoff phase descriptor (Arabic). Returns multi-line text for box.
wad_phasesAccumulation() =>
    'تجميع (Accumulation)\n' +
     '── المراحل ──\n' +
     'A: وقف الاتجاه الهابط\n   (PS, SC, AR, ST)\n' +
     'B: بناء السبب وتذبذب داخل النطاق\n' +
     'C: الاختبار الأخير / Spring\n   (كسر كاذب للدعم)\n' +
     'D: السيطرة على الطلب\n   (SOS, LPS, JAC)\n' +
     'E: الخروج صعوداً (Markup)'

wad_phasesDistribution() =>
    'تصريف (Distribution)\n' +
     '── المراحل ──\n' +
     'A: وقف الاتجاه الصاعد\n   (PSY, BC, AR, ST)\n' +
     'B: بناء السبب الهبوطي\n' +
     'C: الاختبار الأخير / UTAD\n   (كسر كاذب للقمة)\n' +
     'D: السيطرة على العرض\n   (SOW, LPSY)\n' +
     'E: الخروج هبوطاً (Markdown)'

var box      wad_trendBox = na
var string   wad_after    = na

if en_wad and wad_side[1] and not wad_side
    wad_trendBox := box.new(wad_x1, wad_y1, wad_x2, wad_y2, color.gray, 1, line.style_solid, extend.none, xloc.bar_index, wad_x1 < wad_x2 ? color.rgb(120,123,134,90) : na, text_color = color.new(wad_color, 80))

if en_wad and wad_bull
    wad_after := 'Accumulation'
else if en_wad and wad_bear
    wad_after := 'Distribution'

if en_wad and not na(wad_trendBox) and wad_after == 'Accumulation'
    box.set_bgcolor(wad_trendBox, color.rgb(76, 175, 79, 95))
    box.set_text(wad_trendBox, wad_showPhases ? wad_phasesAccumulation() : 'Accumulation')
    box.set_text_size(wad_trendBox, size.small)
    box.set_text_halign(wad_trendBox, text.align_left)
    box.set_text_valign(wad_trendBox, text.align_top)
else if en_wad and not na(wad_trendBox) and wad_after == 'Distribution'
    box.set_bgcolor(wad_trendBox, color.rgb(255, 82, 82, 95))
    box.set_text(wad_trendBox, wad_showPhases ? wad_phasesDistribution() : 'Distribution')
    box.set_text_size(wad_trendBox, size.small)
    box.set_text_halign(wad_trendBox, text.align_left)
    box.set_text_valign(wad_trendBox, text.align_top)

// ── pivots & event flags
wad_rsiLow  = 50 - wad_rsisens
wad_rsiHigh = 50 + wad_rsisens
wad_off     = -wad_pivotLen

wad_pLow   = ta.pivotlow (low , wad_pivotLen, wad_pivotLen)
wad_pHigh  = ta.pivothigh(high, wad_pivotLen, wad_pivotLen)
wad_rsiAtP = wad_rsi[wad_pivotLen]

var bool wad_isSCFlag=false, wad_isARFlag=false, wad_isSTFlag=false, wad_isBCFlag=false, wad_isDARFlag=false, wad_isDSTFlag=false

wad_isSC = wad_pLow and wad_rsiAtP < wad_rsiLow and not wad_isSCFlag and not wad_spring
plotshape(en_wad and wad_isSC, 'WAD SC', location=location.belowbar, style=shape.triangleup,   color=color.green, size=size.tiny, offset=wad_off, text='SC', textcolor=wad_color, display=display.pane)
if en_wad and wad_isSC
    wad_isSCFlag := true

var int wad_scBI = na
if en_wad and wad_isSC
    wad_scBI := bar_index - wad_pivotLen
bool wad_isAR = false
if en_wad and not na(wad_scBI)
    if wad_pHigh and (bar_index - wad_pivotLen > wad_scBI) and not wad_isARFlag
        wad_isAR := true
        wad_scBI := na
if en_wad and wad_isAR
    wad_isARFlag := true
plotshape(en_wad and wad_isAR, 'WAD AR', style=shape.triangledown, location=location.abovebar, color=color.green, size=size.tiny, offset=wad_off, text='AR', textcolor=wad_color, display=display.pane)

var int wad_pivotCounter = 0
if en_wad and wad_pLow
    wad_pivotCounter := wad_pivotCounter + 1
if en_wad and wad_rsiAtP < wad_rsiLow
    wad_pivotCounter := 0
wad_isST = wad_pivotCounter == 1 and wad_pLow and not wad_isSTFlag
plotshape(en_wad and wad_isST, 'WAD ST', location=location.belowbar, style=shape.triangleup,   color=color.green, size=size.tiny, offset=wad_off, text='ST', textcolor=wad_color, display=display.pane)
if en_wad and wad_isST
    wad_isSTFlag := true

wad_isBC = wad_rsiAtP > wad_rsiHigh and wad_pHigh and not wad_isBCFlag and not wad_utad
plotshape(en_wad and wad_isBC, 'WAD BC', location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny, offset=wad_off, text='BC', textcolor=wad_color, display=display.pane)
if en_wad and wad_isBC
    wad_isBCFlag := true

var int wad_bcBI = na
if en_wad and wad_isBC
    wad_bcBI := bar_index - wad_pivotLen
bool wad_isDAR = false
if en_wad and not na(wad_bcBI)
    if wad_pLow and (bar_index - wad_pivotLen > wad_bcBI) and not wad_isDARFlag
        wad_isDAR := true
        wad_bcBI := na
if en_wad and wad_isDAR
    wad_isDARFlag := true
plotshape(en_wad and wad_isDAR, 'WAD DAR', location=location.belowbar, style=shape.triangleup, color=color.red, size=size.tiny, offset=wad_off, text='AR', textcolor=wad_color, display=display.pane)

var int wad_darBI = na
if en_wad and wad_isDAR
    wad_darBI := bar_index - wad_pivotLen
bool wad_isDST = false
if en_wad and not na(wad_darBI)
    if wad_pHigh and (bar_index - wad_pivotLen > wad_darBI) and not wad_isDSTFlag and not wad_isBC
        wad_isDST := true
        wad_darBI := na
if en_wad and wad_isDST
    wad_isDSTFlag := true
plotshape(en_wad and wad_isDST, 'WAD DST', location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny, offset=wad_off, text='ST', textcolor=wad_color, display=display.pane)

plotshape(en_wad and wad_pLow  and not wad_isSC and not wad_isST and not wad_isAR and not wad_isDAR, 'WAD pivLow', location=location.belowbar, style=shape.triangleup,   color=color.orange, size=size.auto, offset=wad_off, display=display.pane)
plotshape(en_wad and wad_pHigh and not wad_isAR and not wad_isDST and not wad_isBC                  , 'WAD pivHigh',location=location.abovebar, style=shape.triangledown, color=color.orange, size=size.auto, offset=wad_off, display=display.pane)

if bar_index != bar_index[1]
    wad_isSCFlag  := false
    wad_isARFlag  := false
    wad_isSTFlag  := false
    wad_isBCFlag  := false
    wad_isDARFlag := false
    wad_isDSTFlag := false


// ══════════════════════════════════════════════════════════════════════════════════════════════════
// (7) FAST / SLOW RSI CROSSOVER — custom (BUY/SELL on cross)
// ══════════════════════════════════════════════════════════════════════════════════════════════════
G7 = '⑦  Fast / Slow RSI Crossover'
fsr_fastLen   = input.int(7 , 'Fast RSI Length', minval=1, group=G7)
fsr_slowLen   = input.int(21, 'Slow RSI Length', minval=2, group=G7)
fsr_src       = input.source(close, 'Source', group=G7)
fsr_showLabel = input.bool(true , 'Show BUY / SELL Labels', group=G7)
fsr_bgOn      = input.bool(true , 'Background Color (Up=Green / Down=Red)', group=G7)
fsr_bullClr   = input.color(color.new(#00C853, 0), 'Bull (Up) Color', group=G7)
fsr_bearClr   = input.color(color.new(#FF1744, 0), 'Bear (Down) Color', group=G7)

fsr_fast = ta.rsi(fsr_src, fsr_fastLen)
fsr_slow = ta.rsi(fsr_src, fsr_slowLen)

fsr_buy  = ta.crossover (fsr_fast, fsr_slow)   // اختراق السريع للبطيء للأعلى = شراء
fsr_sell = ta.crossunder(fsr_fast, fsr_slow)   // كسر السريع للبطيء للأسفل   = بيع
fsr_up   = fsr_fast > fsr_slow                 // ارتفاع
fsr_dn   = fsr_fast < fsr_slow                 // انخفاض

bgcolor(en_fsr and fsr_bgOn and fsr_up ? color.new(fsr_bullClr, 92) : en_fsr and fsr_bgOn and fsr_dn ? color.new(fsr_bearClr, 92) : na, title='FSR Trend BG')

plotshape(en_fsr and fsr_showLabel and fsr_buy , 'FSR BUY' , shape.labelup  , location.belowbar, fsr_bullClr, text='BUY' , textcolor=color.white, size=size.small)
plotshape(en_fsr and fsr_showLabel and fsr_sell, 'FSR SELL', shape.labeldown, location.abovebar, fsr_bearClr, text='SELL', textcolor=color.white, size=size.small)

alertcondition(fsr_buy , 'FSR: BUY (Fast crossed above Slow)' , 'Fast RSI crossed ABOVE Slow RSI → BUY')
alertcondition(fsr_sell, 'FSR: SELL (Fast crossed below Slow)', 'Fast RSI crossed BELOW Slow RSI → SELL')
alertcondition(fsr_up  , 'FSR: Trending UP'  , 'Fast RSI > Slow RSI → Up trend')
alertcondition(fsr_dn  , 'FSR: Trending DOWN', 'Fast RSI < Slow RSI → Down trend')


// ══════════════════════════════════════════════════════════════════════════════════════════════════
//  Logo
// ══════════════════════════════════════════════════════════════════════════════════════════════════
var table aio_logo = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(aio_logo, 0, 0, '☼☾ AIO  ', text_size = size.normal, text_color = color.teal, tooltip = '7 Indicators Combined – each toggle independent')